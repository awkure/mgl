{
  "name": "my-game-library",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "push:ci": "bash scripts/push-and-wait-ci.sh",
    "publish:clipboard": "node scripts/publish-clipboard.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:migrate-assets": "node scripts/migrate-inline-assets.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "steam:probe": "node --experimental-strip-types scripts/steam-probe.mjs",
    "import:steam": "node --experimental-strip-types scripts/import-steam.mjs",
    "import:steam-media": "node --experimental-strip-types scripts/import-steam-media.mjs",
    "import:steam-covers": "node --experimental-strip-types scripts/import-steam-covers.mjs",
    "test:steam": "vitest run tests/steam-live.test.ts",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run benchmarks/vitest",
    "bench:bundle": "node benchmarks/bundle/recordBundleSize.mjs",
    "bench:fps": "node benchmarks/fps/runFps.mjs",
    "bench:lighthouse": "node benchmarks/lighthouse/runLighthouse.mjs",
    "test:e2e": "npm run build && playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@jsquash/webp": "^1.5.0",
    "@tanstack/react-virtual": "^3.14.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.4.1",
    "onnxruntime-node": "^1.27.0",
    "playwright": "^1.61.1",
    "ppu-paddle-ocr": "^6.1.2",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
