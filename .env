# Public GitHub sync target (baked into the client at build time).
# Copy to .env.local to override without committing.
VITE_GITHUB_REPOSITORY_OWNER=kana-sama
VITE_GITHUB_REPOSITORY_NAME=mygameslist
VITE_GITHUB_PAT_NAME="Publish mygameslist"
VITE_GITHUB_PAT_DESCRIPTION="Publish library changes to kana-sama/mygameslist from My Game Library"
