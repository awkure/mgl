# Public GitHub sync target (baked into the client at build time).
# Copy to .env.local to override without committing.
VITE_GITHUB_REPOSITORY_OWNER=awkure
VITE_GITHUB_REPOSITORY_NAME=mgl
VITE_GITHUB_PAT_NAME="Publish mgl"
VITE_GITHUB_PAT_DESCRIPTION="Publish library changes to awkure/mgl from My Game Library"

# Steam Web API (Node scripts only — never prefix with VITE_).
# https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=
# Optional: steamID64 from https://store.steampowered.com/account/ (Steam ID).
# Used by npm run test:steam / steam:probe. Vanity (awkure) and profile URL also work.
STEAM_PROFILE_ID=
